GMAIL_USER=you@gmail.com
# Google account > Security > 2-Step Verification > App passwords
GMAIL_APP_PASSWORD=

PROTON_USER=you@proton.me
# Shown in Proton Mail Bridge, not your Proton login password
PROTON_BRIDGE_PASSWORD=
PROTON_BRIDGE_HOST=127.0.0.1
PROTON_BRIDGE_PORT=1143

# Abort --apply if more than this share of scanned Gmail mail is flagged
MAX_FLAGGED_RATIO=0.3
# Ignore Gmail mail younger than this (forwarding delay)
MIN_AGE_DAYS=1
